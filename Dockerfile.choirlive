# Build from repository ROOT: docker build -f Dockerfile.choirlive --build-arg VITE_CHOIRCORE_URL=wss://signal.example.org .
FROM node:22-bookworm-slim AS build
WORKDIR /workspace/choir-live/app
COPY choir-live/app/package.json choir-live/app/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY choir-live/app/ ./
COPY choircore/sdk/ /workspace/choircore/sdk/
ARG VITE_CHOIRCORE_URL
RUN test -n "$VITE_CHOIRCORE_URL" && \
  case "$VITE_CHOIRCORE_URL" in wss://*) ;; *) echo "Require wss:// VITE_CHOIRCORE_URL" >&2; exit 1;; esac && \
  VITE_CHOIRCORE_URL="$VITE_CHOIRCORE_URL" npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.choirlive.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/choir-live/app/dist/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
